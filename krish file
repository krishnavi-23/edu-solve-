<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>LearnLoop — Smart Learning Platform</title>

<style>

/* =========================================================
   LEARNLOOP PREMIUM UI
   ========================================================= */

:root {
    --primary: #6c5ce7;
    --primary2: #8b5cf6;
    --cyan: #06b6d4;
    --pink: #ec4899;

    --dark: #080b18;
    --dark2: #10152b;

    --text: #f8fafc;
    --muted: #9aa4bd;

    --glass: rgba(255,255,255,0.065);
    --glass-border: rgba(255,255,255,0.12);

    --success: #22c55e;
    --warning: #f59e0b;
    --danger: #ef4444;

    --shadow:
        0 25px 80px rgba(0,0,0,0.35);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    background:
        radial-gradient(circle at 10% 10%, rgba(108,92,231,.20), transparent 30%),
        radial-gradient(circle at 90% 20%, rgba(6,182,212,.13), transparent 28%),
        radial-gradient(circle at 50% 100%, rgba(236,72,153,.10), transparent 30%),
        var(--dark);

    color: var(--text);
    min-height: 100vh;
    overflow-x: hidden;
}

button,
input {
    font: inherit;
}

button {
    cursor: pointer;
}

/* =========================================================
   3D BACKGROUND
   ========================================================= */

.background {
    position: fixed;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: -1;
}

.orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    opacity: .55;
    animation: float 12s ease-in-out infinite;
}

.orb.one {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle at 30% 30%, #8b5cf6, #4c1d95);
    top: -100px;
    left: -100px;
}

.orb.two {
    width: 240px;
    height: 240px;
    background: radial-gradient(circle at 30% 30%, #06b6d4, #164e63);
    right: -70px;
    top: 25%;
    animation-delay: -4s;
}

.orb.three {
    width: 190px;
    height: 190px;
    background: radial-gradient(circle at 30% 30%, #ec4899, #831843);
    bottom: -60px;
    left: 40%;
    animation-delay: -7s;
}

@keyframes float {

    0%,100% {
        transform: translate3d(0,0,0) scale(1);
    }

    50% {
        transform: translate3d(0,-35px,0) scale(1.08);
    }
}

/* =========================================================
   NAVBAR
   ========================================================= */

.navbar {
    height: 72px;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 5%;

    background: rgba(8,11,24,.70);
    backdrop-filter: blur(18px);

    border-bottom: 1px solid rgba(255,255,255,.08);

    z-index: 1000;
}

.logo {
    display: flex;
    align-items: center;
    gap: 11px;

    font-size: 1.35rem;
    font-weight: 800;
}

.logo-icon {
    width: 40px;
    height: 40px;

    display: grid;
    place-items: center;

    border-radius: 13px;

    background:
        linear-gradient(135deg,var(--primary),var(--pink));

    box-shadow:
        0 8px 30px rgba(108,92,231,.45);

    animation: logoFloat 4s ease-in-out infinite;
}

@keyframes logoFloat {
    50% {
        transform: translateY(-3px) rotate(3deg);
    }
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 7px;
}

.nav-btn {
    border: none;
    background: transparent;
    color: #aab3c9;

    padding: 9px 13px;
    border-radius: 9px;

    transition: .2s;
}

.nav-btn:hover,
.nav-btn.active {
    color: white;
    background: rgba(255,255,255,.08);
}

.login-nav {
    color: white;
    background: linear-gradient(135deg,var(--primary),var(--primary2));
}

/* =========================================================
   PAGE SYSTEM
   ========================================================= */

.page {
    display: none;
    min-height: 100vh;
    padding-top: 72px;
    animation: pageIn .45s ease;
}

.page.active {
    display: block;
}

@keyframes pageIn {
    from {
        opacity: 0;
        transform: translateY(12px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.container {
    width: min(1180px,92%);
    margin: auto;
}

/* =========================================================
   LANDING PAGE
   ========================================================= */

.hero {
    min-height: calc(100vh - 72px);

    display: grid;
    grid-template-columns: 1.05fr .95fr;
    align-items: center;
    gap: 60px;
}

.badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    padding: 8px 13px;

    border-radius: 100px;

    background: rgba(139,92,246,.13);
    border: 1px solid rgba(139,92,246,.25);

    color: #c4b5fd;

    font-size: .82rem;
    font-weight: 700;

    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(3rem,7vw,6.2rem);
    line-height: .96;
    letter-spacing: -4px;

    margin-bottom: 25px;
}

.gradient-text {
    background:
        linear-gradient(
            110deg,
            #a78bfa,
            #22d3ee,
            #f0abfc
        );

    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero p {
    color: var(--muted);
    max-width: 600px;

    font-size: 1.08rem;
    line-height: 1.75;

    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.btn {
    border: none;

    padding: 13px 20px;
    border-radius: 11px;

    font-weight: 700;

    transition: .25s;
}

.btn-primary {
    color: white;

    background:
        linear-gradient(
            135deg,
            var(--primary),
            var(--pink)
        );

    box-shadow:
        0 12px 30px rgba(108,92,231,.35);
}

.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow:
        0 18px 40px rgba(108,92,231,.45);
}

.btn-secondary {
    color: white;
    background: rgba(255,255,255,.06);
    border: 1px solid var(--glass-border);
}

.btn-secondary:hover {
    background: rgba(255,255,255,.1);
}

/* =========================================================
   3D HERO CARD
   ========================================================= */

.scene {
    perspective: 1200px;
}

.dashboard-3d {
    position: relative;

    transform:
        rotateY(-12deg)
        rotateX(7deg)
        rotateZ(1deg);

    transition: transform .5s ease;

    animation: dashboardFloat 6s ease-in-out infinite;

    filter:
        drop-shadow(0 35px 45px rgba(0,0,0,.35));
}

.dashboard-3d:hover {
    transform:
        rotateY(-4deg)
        rotateX(2deg)
        scale(1.02);
}

@keyframes dashboardFloat {
    50% {
        transform:
            rotateY(-8deg)
            rotateX(5deg)
            translateY(-15px);
    }
}

.mock-dashboard {
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.13),
            rgba(255,255,255,.035)
        );

    border:
        1px solid rgba(255,255,255,.16);

    border-radius: 25px;

    padding: 20px;

    box-shadow:
        0 30px 100px rgba(0,0,0,.4),
        inset 0 1px rgba(255,255,255,.12);

    backdrop-filter: blur(20px);
}

.mock-top {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
}

.mock-title {
    font-weight: 800;
}

.mock-small {
    color: var(--muted);
    font-size: .75rem;
}

.mock-progress {
    height: 9px;
    background: rgba(255,255,255,.08);
    border-radius: 20px;
    overflow: hidden;
    margin: 8px 0 20px;
}

.mock-progress span {
    display: block;
    width: 72%;
    height: 100%;
    background: linear-gradient(90deg,#8b5cf6,#22d3ee);
}

.mock-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.mock-card {
    padding: 16px;
    border-radius: 15px;
    background: rgba(255,255,255,.055);
    border: 1px solid rgba(255,255,255,.07);
}

.mock-card strong {
    display: block;
    margin-top: 7px;
}

/* =========================================================
   GLASS CARDS
   ========================================================= */

.glass {
    background: var(--glass);
    border: 1px solid var(--glass-border);

    border-radius: 20px;

    backdrop-filter: blur(18px);

    box-shadow: var(--shadow);
}

.content {
    padding: 35px 0 70px;
}

.page-heading {
    margin: 30px 0;
}

.page-heading h1 {
    font-size: 2.2rem;
    margin-bottom: 7px;
}

.page-heading p {
    color: var(--muted);
}

/* =========================================================
   DASHBOARD
   ========================================================= */

.dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 25px;
}

.welcome h1 {
    font-size: 2rem;
    margin-bottom: 6px;
}

.welcome p {
    color: var(--muted);
}

.avatar {
    width: 52px;
    height: 52px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    background:
        linear-gradient(135deg,var(--primary),var(--pink));

    font-weight: 800;
}

/* STATS */

.stats {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 15px;
    margin-bottom: 20px;
}

.stat {
    padding: 20px;
}

.stat-label {
    color: var(--muted);
    font-size: .82rem;
}

.stat-value {
    font-size: 1.7rem;
    font-weight: 800;
    margin-top: 7px;
}

.stat-icon {
    float: right;
    font-size: 1.4rem;
}

/* DASHBOARD GRID */

.dashboard-grid {
    display: grid;
    grid-template-columns: 1.4fr .8fr;
    gap: 20px;
}

.panel {
    padding: 24px;
}

.panel-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
}

.panel-heading h2 {
    font-size: 1.05rem;
}

.panel-heading span {
    color: var(--muted);
    font-size: .8rem;
}

/* NEXT TOPIC */

.next-topic {
    padding: 24px;

    border-radius: 17px;

    background:
        radial-gradient(
            circle at 100% 0,
            rgba(139,92,246,.3),
            transparent 45%
        ),
        rgba(255,255,255,.05);

    border: 1px solid rgba(139,92,246,.25);
}

.next-label {
    color: #c4b5fd;
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 800;
}

.next-topic h2 {
    font-size: 1.7rem;
    margin: 8px 0;
}

.next-topic p {
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 18px;
}

/* TOPICS */

.topic-row {
    display: flex;
    align-items: center;
    gap: 13px;

    padding: 13px;

    border-bottom: 1px solid rgba(255,255,255,.06);
}

.topic-row:last-child {
    border-bottom: none;
}

.topic-check {
    width: 19px;
    height: 19px;
    accent-color: var(--success);
}

.topic-name {
    flex: 1;
}

.topic-complete {
    color: #64748b;
    text-decoration: line-through;
}

.topic-status {
    color: var(--muted);
    font-size: .75rem;
}

/* =========================================================
   SUBJECT PAGE
   ========================================================= */

.subject-grid {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 15px;
}

.subject-card {
    padding: 24px;

    border-radius: 18px;

    background: var(--glass);
    border: 1px solid var(--glass-border);

    transition: .3s;

    cursor: pointer;
}

.subject-card:hover {
    transform: translateY(-6px) scale(1.01);

    border-color: rgba(139,92,246,.45);

    box-shadow:
        0 20px 50px rgba(0,0,0,.25);
}

.subject-icon {
    font-size: 2.2rem;
    margin-bottom: 14px;
}

.subject-card h3 {
    margin-bottom: 6px;
}

.subject-card p {
    color: var(--muted);
    font-size: .82rem;
}

/* =========================================================
   PROGRESS
   ========================================================= */

.progress-layout {
    display: grid;
    grid-template-columns: .7fr 1.3fr;
    gap: 20px;
}

.progress-circle {
    width: 190px;
    height: 190px;

    margin: 15px auto;

    border-radius: 50%;

    display: grid;
    place-items: center;

    background:
        conic-gradient(
            var(--primary) 72%,
            rgba(255,255,255,.07) 0
        );

    position: relative;
}

.progress-circle::before {
    content: "";
    position: absolute;

    width: 145px;
    height: 145px;

    border-radius: 50%;

    background: #10152b;
}

.progress-circle strong {
    position: relative;
    font-size: 2.3rem;
}

/* BARS */

.bar {
    margin: 18px 0;
}

.bar-top {
    display: flex;
    justify-content: space-between;
    margin-bottom: 7px;
    font-size: .85rem;
}

.bar-top span:last-child {
    color: var(--muted);
}

.bar-track {
    height: 8px;
    background: rgba(255,255,255,.07);
    border-radius: 20px;
    overflow: hidden;
}

.bar-fill {
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg,var(--primary),var(--cyan));
}

/* =========================================================
   LOGIN
   ========================================================= */

.login-wrapper {
    min-height: calc(100vh - 72px);

    display: grid;
    place-items: center;
}

.login-card {
    width: min(430px,100%);
    padding: 35px;
}

.login-card h1 {
    font-size: 2rem;
    margin-bottom: 8px;
}

.login-card > p {
    color: var(--muted);
    margin-bottom: 25px;
    line-height: 1.5;
}

.input-group {
    margin-bottom: 15px;
}

.input-group label {
    display: block;
    color: #cbd5e1;
    font-size: .82rem;
    margin-bottom: 7px;
}

.input-group input {
    width: 100%;

    padding: 13px 14px;

    color: white;

    background: rgba(255,255,255,.055);

    border:
        1px solid
        rgba(255,255,255,.1);

    border-radius: 10px;

    outline: none;
}

.input-group input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(108,92,231,.15);
}

.login-card .btn {
    width: 100%;
    margin-top: 7px;
}

.demo-note {
    margin-top: 18px;
    text-align: center;
    color: #64748b;
    font-size: .75rem;
}

/* =========================================================
   PARENT DASHBOARD
   ========================================================= */

.parent-banner {
    padding: 24px;

    background:
        linear-gradient(
            135deg,
            rgba(108,92,231,.18),
            rgba(6,182,212,.08)
        );

    border: 1px solid rgba(108,92,231,.22);

    border-radius: 20px;

    margin-bottom: 20px;
}

.parent-banner h2 {
    margin-bottom: 6px;
}

.parent-banner p {
    color: var(--muted);
}

/* =========================================================
   PROFILE
   ========================================================= */

.profile-card {
    max-width: 650px;
    padding: 28px;
}

.profile-head {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 25px;
}

.big-avatar {
    width: 70px;
    height: 70px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    font-size: 1.5rem;
    font-weight: 800;

    background:
        linear-gradient(
            135deg,
            var(--primary),
            var(--pink)
        );
}

/* =========================================================
   TOAST
   ========================================================= */

.toast {
    position: fixed;

    right: 22px;
    bottom: 22px;

    padding: 13px 17px;

    background: #161d35;

    border:
        1px solid
        rgba(255,255,255,.1);

    border-radius: 12px;

    box-shadow: var(--shadow);

    transform: translateY(120px);
    opacity: 0;

    transition: .3s;

    z-index: 2000;
}

.toast.show {
    transform: translateY(0);
    opacity: 1;
}

/* =========================================================
   MOBILE
   ========================================================= */

@media(max-width:850px) {

    .hero {
        grid-template-columns: 1fr;
        padding: 60px 0;
    }

    .hero h1 {
        letter-spacing: -2px;
    }

    .dashboard-grid,
    .progress-layout {
        grid-template-columns: 1fr;
    }

    .stats {
        grid-template-columns: repeat(2,1fr);
    }

    .subject-grid {
        grid-template-columns: repeat(2,1fr);
    }

    .nav-links .optional {
        display: none;
    }
}

@media(max-width:600px) {

    .navbar {
        padding: 0 4%;
    }

    .nav-links {
        gap: 2px;
    }

    .nav-btn {
        padding: 8px;
        font-size: .78rem;
    }

    .container {
        width: 92%;
    }

    .hero {
        text-align: center;
    }

    .hero-buttons {
        justify-content: center;
    }

    .stats {
        grid-template-columns: 1fr 1fr;
    }

    .subject-grid {
        grid-template-columns: 1fr;
    }

    .dashboard-header {
        align-items: flex-start;
    }

    .login-card {
        padding: 25px;
    }

}

</style>
</head>


<body>

<!-- =========================================================
     ANIMATED BACKGROUND
     ========================================================= -->

<div class="background">
    <div class="orb one"></div>
    <div class="orb two"></div>
    <div class="orb three"></div>
</div>


<!-- =========================================================
     NAVIGATION
     ========================================================= -->

<nav class="navbar">

    <div class="logo">
        <div class="logo-icon">↻</div>
        LearnLoop
    </div>

    <div class="nav-links">

        <button class="nav-btn" onclick="showPage('home')">
            Home
        </button>

        <button class="nav-btn optional" onclick="showPage('dashboard')">
            Dashboard
        </button>

        <button class="nav-btn optional" onclick="showPage('subjects')">
            Subjects
        </button>

        <button class="nav-btn optional" onclick="showPage('progress')">
            Progress
        </button>

        <button class="nav-btn login-nav" onclick="showPage('login')">
            Student Login
        </button>

    </div>

</nav>


<!-- =========================================================
     HOME PAGE
     ========================================================= -->

<section class="page active" id="home">

    <div class="container">

        <div class="hero">

            <div>

                <div class="badge">
                    ✨ AI-ready learning experience
                </div>

                <h1>
                    Don't just study.
                    <span class="gradient-text">
                        Learn in a loop.
                    </span>
                </h1>

                <p>
                    LearnLoop helps students organize topics,
                    track progress and instantly discover
                    what they should study next.
                </p>

                <div class="hero-buttons">

                    <button
                        class="btn btn-primary"
                        onclick="showPage('login')">
                        Start Learning →
                    </button>

                    <button
                        class="btn btn-secondary"
                        onclick="showPage('dashboard')">
                        Explore Dashboard
                    </button>

                </div>

            </div>


            <!-- 3D PREVIEW -->

            <div class="scene">

                <div class="dashboard-3d">

                    <div class="mock-dashboard">

                        <div class="mock-top">

                            <div>
                                <div class="mock-small">
                                    GOOD MORNING
                                </div>

                                <div class="mock-title">
                                    Student Dashboard
                                </div>
                            </div>

                            <div>
                                🎓
                            </div>

                        </div>


                        <div class="mock-small">
                            Overall Progress
                        </div>

                        <div class="mock-progress">
                            <span></span>
                        </div>


                        <div class="mock-grid">

                            <div class="mock-card">
                                📐
                                <div class="mock-small">
                                    Mathematics
                                </div>
                                <strong>
                                    72%
                                </strong>
                            </div>

                            <div class="mock-card">
                                ⚡
                                <div class="mock-small">
                                    Physics
                                </div>
                                <strong>
                                    58%
                                </strong>
                            </div>

                            <div class="mock-card">
                                💻
                                <div class="mock-small">
                                    Computer Science
                                </div>
                                <strong>
                                    86%
                                </strong>
                            </div>

                            <div class="mock-card">
                                🎯
                                <div class="mock-small">
                                    Next Topic
                                </div>
                                <strong>
                                    Algorithms
                                </strong>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     LOGIN PAGE
     ========================================================= -->

<section class="page" id="login">

    <div class="container login-wrapper">

        <div class="glass login-card">

            <div class="badge">
                🔐 Student Portal
            </div>

            <h1>
                Welcome back.
            </h1>

            <p>
                Sign in to continue your learning journey.
            </p>


            <div class="input-group">

                <label>
                    Student Name
                </label>

                <input
                    id="studentName"
                    type="text"
                    placeholder="Enter your name"
                    value="Alex"
                >

            </div>


            <div class="input-group">

                <label>
                    Email
                </label>

                <input
                    id="studentEmail"
                    type="email"
                    placeholder="student@example.com"
                    value="student@example.com"
                >

            </div>


            <button
                class="btn btn-primary"
                onclick="loginStudent()">

                Enter LearnLoop →

            </button>


            <div class="demo-note">
                Demo login • No real account required
            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     STUDENT DASHBOARD
     ========================================================= -->

<section class="page" id="dashboard">

    <div class="container content">

        <div class="dashboard-header">

            <div class="welcome">

                <h1>
                    Good morning, <span id="welcomeName">Alex</span> 👋
                </h1>

                <p>
                    Here's what your learning loop looks like today.
                </p>

            </div>

            <div class="avatar" id="avatar">
                A
            </div>

